# Copy this file to ".env" and fill in the keys you need.
OPENAI_API_KEY=              # GPT-4o, GPT-4o mini, gpt-image-1, vision runs
AWS_BEARER_TOKEN_BEDROCK=    # Amazon Bedrock API key (Claude, Nova, Llama)
BEDROCK_REGION=us-east-1
OPENROUTER_API_KEY=          # Jev (decision-native model)

# Optional defaults
PRIMARY_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o-mini

# Cost safety: absolute ceiling for any single run (clamps --max-budget),
# and an independent call ceiling. Verify with: python src/check_cost_safety.py
LLM_AUDIT_HARD_CAP_USD=25
LLM_AUDIT_HARD_CAP_CALLS=200000
